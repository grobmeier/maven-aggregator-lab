<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<plugin>
  <name>Learning child JAR collector</name>
  <description>A small aggregator goal with an explicit descriptor for inspection.</description>
  <groupId>maven.aggregator.lab</groupId>
  <artifactId>aggregator-lab-maven-plugin</artifactId>
  <version>1.0-SNAPSHOT</version>
  <goalPrefix>aggregator-lab</goalPrefix>
  <isolatedRealm>false</isolatedRealm>
  <inheritedByDefault>true</inheritedByDefault>
  <mojos>
    <mojo>
      <goal>collect</goal>
      <description>Require both child JARs and collect them in one ZIP.</description>
      <requiresDirectInvocation>false</requiresDirectInvocation>
      <requiresProject>true</requiresProject>
      <aggregator>true</aggregator>
      <requiresOnline>false</requiresOnline>
      <inheritedByDefault>true</inheritedByDefault>
      <implementation>maven.aggregator.lab.CollectMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter>
          <name>baseDirectory</name>
          <type>java.io.File</type>
          <required>true</required>
          <editable>false</editable>
          <description>The directory of the project that executes this goal.</description>
        </parameter>
      </parameters>
      <configuration>
        <baseDirectory implementation="java.io.File" default-value="${project.basedir}"/>
      </configuration>
    </mojo>
    <mojo>
      <goal>probe</goal>
      <description>Record lifecycle events and collect fixture contributions.</description>
      <requiresDirectInvocation>false</requiresDirectInvocation>
      <requiresProject>true</requiresProject>
      <aggregator>true</aggregator>
      <requiresOnline>false</requiresOnline>
      <inheritedByDefault>true</inheritedByDefault>
      <implementation>maven.aggregator.lab.ProbeMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter>
          <name>baseDirectory</name><type>java.io.File</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: baseDirectory.</description>
        </parameter>
        <parameter>
          <name>eventRoot</name><type>java.io.File</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: eventRoot.</description>
        </parameter>
        <parameter>
          <name>project</name><type>org.apache.maven.project.MavenProject</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: project.</description>
        </parameter>
        <parameter>
          <name>projects</name><type>java.util.List</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: projects.</description>
        </parameter>
        <parameter>
          <name>action</name><type>java.lang.String</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: action.</description>
        </parameter>
        <parameter>
          <name>contributors</name><type>java.lang.String</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: contributors.</description>
        </parameter>
        <parameter>
          <name>failureStage</name><type>java.lang.String</type><required>false</required><editable>true</editable>
          <description>The stage of the deliberate contributor failure.</description>
        </parameter>
        <parameter>
          <name>failContributor</name><type>java.lang.String</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: failContributor.</description>
        </parameter>
      </parameters>
      <configuration>
        <baseDirectory implementation="java.io.File" default-value="${project.basedir}"/>
        <eventRoot implementation="java.io.File" default-value="${demo.eventRoot}"/>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <projects implementation="java.util.List" default-value="${session.projects}"/>
        <action implementation="java.lang.String" default-value="${demo.action}"/>
        <contributors implementation="java.lang.String" default-value="${demo.contributors}"/>
        <failureStage implementation="java.lang.String" default-value="${demo.failureStage}"/>
        <failContributor implementation="java.lang.String" default-value="${demo.failContributor}"/>
      </configuration>
    </mojo>
    <mojo>
      <goal>work</goal>
      <description>Record lifecycle events and collect fixture contributions.</description>
      <requiresDirectInvocation>false</requiresDirectInvocation>
      <requiresProject>true</requiresProject>
      <aggregator>false</aggregator>
      <requiresOnline>false</requiresOnline>
      <inheritedByDefault>true</inheritedByDefault>
      <implementation>maven.aggregator.lab.ProbeMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter>
          <name>baseDirectory</name><type>java.io.File</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: baseDirectory.</description>
        </parameter>
        <parameter>
          <name>eventRoot</name><type>java.io.File</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: eventRoot.</description>
        </parameter>
        <parameter>
          <name>project</name><type>org.apache.maven.project.MavenProject</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: project.</description>
        </parameter>
        <parameter>
          <name>projects</name><type>java.util.List</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: projects.</description>
        </parameter>
        <parameter>
          <name>action</name><type>java.lang.String</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: action.</description>
        </parameter>
        <parameter>
          <name>contributors</name><type>java.lang.String</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: contributors.</description>
        </parameter>
        <parameter>
          <name>failureStage</name><type>java.lang.String</type><required>false</required><editable>true</editable>
          <description>The stage of the deliberate contributor failure.</description>
        </parameter>
        <parameter>
          <name>failContributor</name><type>java.lang.String</type><required>false</required><editable>true</editable>
          <description>Acceptance fixture parameter: failContributor.</description>
        </parameter>
      </parameters>
      <configuration>
        <baseDirectory implementation="java.io.File" default-value="${project.basedir}"/>
        <eventRoot implementation="java.io.File" default-value="${demo.eventRoot}"/>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <projects implementation="java.util.List" default-value="${session.projects}"/>
        <action implementation="java.lang.String" default-value="${demo.action}"/>
        <contributors implementation="java.lang.String" default-value="${demo.contributors}"/>
        <failureStage implementation="java.lang.String" default-value="${demo.failureStage}"/>
        <failContributor implementation="java.lang.String" default-value="${demo.failContributor}"/>
      </configuration>
    </mojo>
  </mojos>
  <dependencies/>
</plugin>
